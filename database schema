CREATE OR REPLACE VIEW public.active_agents
AS SELECT agent_id,
    agent_name,
    email,
    department,
    employee_id,
    last_login,
    email_verified,
    created_at
   FROM agents
  WHERE is_active = true
  ORDER BY last_login DESC NULLS LAST;

CREATE OR REPLACE VIEW public.agent_security_status
AS SELECT agent_id,
    agent_name,
    email,
    is_active,
    email_verified,
    failed_login_attempts,
        CASE
            WHEN account_locked_until > CURRENT_TIMESTAMP THEN 'LOCKED'::text
            WHEN is_active = false THEN 'DISABLED'::text
            WHEN email_verified = false THEN 'UNVERIFIED'::text
            ELSE 'ACTIVE'::text
        END AS status,
    account_locked_until,
    last_login,
    COALESCE(( SELECT count(*) AS count
           FROM auth_audit_log
          WHERE auth_audit_log.agent_id = agents.agent_id AND auth_audit_log.event_type::text = 'failed_login'::text AND auth_audit_log.created_at > (CURRENT_TIMESTAMP - '24:00:00'::interval)), 0::bigint) AS failed_logins_24h
   FROM agents
  ORDER BY agent_name;

CREATE OR REPLACE VIEW public.customer_call_history
AS SELECT cl.call_id,
    cl.customer_id,
    cl.agent_id,
    cl.call_date,
    cl.call_duration,
    cl.audio_filename,
    cl.processing_status,
    cl.primary_intent,
    cl.sentiment,
    cl.sentiment_score,
    cl.urgency,
    cl.quality_score,
    cl.csat_estimate,
    cl.resolution_status,
    cr.call_summary,
    cr.emotional_tone,
    cr.churn_risk_assessment,
    a.agent_name
   FROM calls cl
     LEFT JOIN call_reports cr ON cl.call_id = cr.call_id
     LEFT JOIN agents a ON cl.agent_id = a.agent_id;

CREATE OR REPLACE VIEW public.recent_login_activity
AS SELECT a.agent_id,
    a.agent_name,
    a.email,
    a.department,
    al.event_type,
    al.ip_address,
    al.success,
    al.created_at
   FROM auth_audit_log al
     JOIN agents a ON al.agent_id = a.agent_id
  WHERE (al.event_type::text = ANY (ARRAY['login'::character varying, 'failed_login'::character varying]::text[])) AND al.created_at > (CURRENT_TIMESTAMP - '24:00:00'::interval)
  ORDER BY al.created_at DESC;
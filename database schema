CREATE TABLE public.agents (
	agent_id serial4 NOT NULL,
	agent_name varchar(255) NOT NULL,
	employee_id varchar(50) NULL,
	email varchar(255) NOT NULL,
	total_calls_handled int4 DEFAULT 0 NULL,
	average_quality_score numeric(5, 2) NULL,
	average_csat numeric(3, 2) NULL,
	status varchar(500) DEFAULT 'active'::character varying NULL,
	department varchar(100) NULL,
	hired_date date NULL,
	created_at timestamp DEFAULT CURRENT_TIMESTAMP NULL,
	updated_at timestamp DEFAULT CURRENT_TIMESTAMP NULL,
	password_hash varchar(255) NULL,
	is_active bool DEFAULT true NULL,
	last_login timestamp NULL,
	failed_attempts int4 DEFAULT 0 NULL,
	locked_until timestamp NULL,
	email_verified bool DEFAULT false NULL,
	last_login_ip varchar(500) NULL,
	failed_login_attempts int4 DEFAULT 0 NULL,
	account_locked_until timestamp NULL,
	password_reset_token varchar(255) NULL,
	password_reset_expires timestamp NULL,
	CONSTRAINT agents_email_unique UNIQUE (email),
	CONSTRAINT agents_employee_id_key UNIQUE (employee_id),
	CONSTRAINT agents_pkey PRIMARY KEY (agent_id)
);

CREATE INDEX idx_agents_email ON public.agents USING btree (email);
CREATE INDEX idx_agents_email_lower ON public.agents USING btree (lower((email)::text));
CREATE INDEX idx_agents_is_active ON public.agents USING btree (is_active);
CREATE INDEX idx_agents_last_login ON public.agents USING btree (last_login DESC);
CREATE INDEX idx_agents_password_reset_token ON public.agents USING btree (password_reset_token) WHERE (password_reset_token IS NOT NULL);

CREATE TRIGGER update_agents_updated_at BEFORE UPDATE ON public.agents FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();


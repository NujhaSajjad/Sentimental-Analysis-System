CREATE OR REPLACE FUNCTION public.update_updated_at_column()
 RETURNS trigger
 LANGUAGE plpgsql
AS $function$
BEGIN
    NEW.updated_at = CURRENT_TIMESTAMP;
    RETURN NEW;
END;
$function$
;

CREATE OR REPLACE FUNCTION public.update_customer_stats()
 RETURNS trigger
 LANGUAGE plpgsql
AS $function$
BEGIN
    UPDATE customers
    SET
        total_calls       = (SELECT COUNT(*) FROM calls WHERE customer_id = NEW.customer_id),
        last_contact_date = NEW.call_date,
        updated_at        = CURRENT_TIMESTAMP
    WHERE customer_id = NEW.customer_id;
    RETURN NEW;
END;
$function$
;

CREATE OR REPLACE FUNCTION public.auto_unlock_accounts()
 RETURNS integer
 LANGUAGE plpgsql
AS $function$
DECLARE
    unlocked_count INTEGER;
BEGIN
    UPDATE agents
    SET 
        account_locked_until = NULL,
        failed_login_attempts = 0
    WHERE 
        account_locked_until IS NOT NULL 
        AND account_locked_until <= CURRENT_TIMESTAMP;
    
    GET DIAGNOSTICS unlocked_count = ROW_COUNT;
    RETURN unlocked_count;
END;
$function$
;

CREATE OR REPLACE FUNCTION public.calculate_customer_sentiment(p_customer_id integer)
 RETURNS TABLE(overall_sentiment character varying, overall_score numeric, sentiment_trend character varying)
 LANGUAGE plpgsql
AS $function$
DECLARE
    pos_count   INTEGER;
    neg_count   INTEGER;
    neu_count   INTEGER;
    avg_score   DECIMAL;
    v_sentiment VARCHAR;
    v_trend     VARCHAR;
BEGIN
    SELECT
        COUNT(*) FILTER (WHERE sentiment = 'Positive'),
        COUNT(*) FILTER (WHERE sentiment = 'Negative'),
        COUNT(*) FILTER (WHERE sentiment = 'Neutral'),
        AVG(sentiment_score)
    INTO pos_count, neg_count, neu_count, avg_score
    FROM calls
    WHERE customer_id = p_customer_id;

    IF pos_count >= neg_count AND pos_count >= neu_count THEN
        v_sentiment := 'Positive';
    ELSIF neg_count > pos_count AND neg_count >= neu_count THEN
        v_sentiment := 'Negative';
    ELSE
        v_sentiment := 'Neutral';
    END IF;

    -- Trend: compare most recent 3 vs previous 3 calls
    SELECT
        CASE
            WHEN AVG(recent.sentiment_score) > AVG(prev.sentiment_score) THEN 'improving'
            WHEN AVG(recent.sentiment_score) < AVG(prev.sentiment_score) THEN 'declining'
            ELSE 'stable'
        END
    INTO v_trend
    FROM (
        SELECT sentiment_score FROM calls
        WHERE customer_id = p_customer_id AND sentiment_score IS NOT NULL
        ORDER BY call_date DESC LIMIT 3
    ) recent
    CROSS JOIN (
        SELECT sentiment_score FROM calls
        WHERE customer_id = p_customer_id AND sentiment_score IS NOT NULL
        ORDER BY call_date DESC LIMIT 3 OFFSET 3
    ) prev;

    RETURN QUERY SELECT v_sentiment, COALESCE(avg_score, 0), COALESCE(v_trend, 'stable');
END;
$function$
;

CREATE OR REPLACE FUNCTION public.clean_expired_sessions()
 RETURNS integer
 LANGUAGE plpgsql
AS $function$
DECLARE
    deleted_count INTEGER;
BEGIN
    DELETE FROM active_sessions
    WHERE expires_at < CURRENT_TIMESTAMP
       OR revoked_at IS NOT NULL;
    
    GET DIAGNOSTICS deleted_count = ROW_COUNT;
    RETURN deleted_count;
END;
$function$
;

CREATE OR REPLACE FUNCTION public.clean_old_audit_logs(days_to_keep integer DEFAULT 90)
 RETURNS integer
 LANGUAGE plpgsql
AS $function$
DECLARE
    deleted_count INTEGER;
BEGIN
    DELETE FROM auth_audit_log
    WHERE created_at < CURRENT_TIMESTAMP - (days_to_keep || ' days')::INTERVAL;
    
    GET DIAGNOSTICS deleted_count = ROW_COUNT;
    RETURN deleted_count;
END;
$function$
;

CREATE OR REPLACE FUNCTION public.is_account_locked(p_agent_id integer)
 RETURNS boolean
 LANGUAGE plpgsql
AS $function$
DECLARE
    locked_until TIMESTAMP;
BEGIN
    SELECT account_locked_until INTO locked_until
    FROM agents
    WHERE agent_id = p_agent_id;
    
    RETURN locked_until IS NOT NULL AND locked_until > CURRENT_TIMESTAMP;
END;
$function$
;

CREATE OR REPLACE FUNCTION public.search_customers(search_term character varying)
 RETURNS TABLE(customer_id integer, cnic character varying, phone_number character varying, full_name character varying, company_name character varying, email character varying, total_calls integer, overall_sentiment character varying, sentiment_trend character varying, churn_risk character varying)
 LANGUAGE plpgsql
AS $function$
BEGIN
    RETURN QUERY
    SELECT
        c.customer_id,
        c.cnic,
        c.phone_number,
        c.full_name,
        c.company_name,
        c.email,
        c.total_calls,
        c.overall_sentiment,
        c.sentiment_trend,
        c.churn_risk
    FROM customers c
    WHERE
        c.cnic         ILIKE '%' || search_term || '%'
     OR c.phone_number ILIKE '%' || search_term || '%'
     OR c.full_name    ILIKE '%' || search_term || '%'
     OR c.company_name ILIKE '%' || search_term || '%'
    ORDER BY c.total_calls DESC, c.full_name ASC
    LIMIT 20;
END;
$function$
;


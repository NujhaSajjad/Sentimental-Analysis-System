# ==============================================================================
# ENVIRONMENT CONFIGURATION EXAMPLE (.env.example)
# ==============================================================================
# Do not commit real values to version control.
# Copy this file to .env and fill in the corresponding values.

# ------------------------------------------------------------------------------
# 1. Server Configuration
# ------------------------------------------------------------------------------
# The port the Node.js backend should run on. Default: 3000
PORT=3000
# The environment type: 'development', 'test', or 'production'
NODE_ENV=production

# ------------------------------------------------------------------------------
# 2. Security & Authentication
# ------------------------------------------------------------------------------
# JWT Secret Key - MUST BE AT LEAST 64 CHARACTERS for production.
# Generate using: `node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"`
JWT_SECRET=your-production-jwt-secret-key-goes-here
JWT_EXPIRES_IN=8h
# Secret key used for initial system setup/admin configuration
SETUP_KEY=your-production-setup-key

# ------------------------------------------------------------------------------
# 3. Database Configuration (PostgreSQL)
# ------------------------------------------------------------------------------
DB_USER=your_db_user
DB_HOST=your_db_host.rds.amazonaws.com
DB_NAME=your_db_name
DB_PASSWORD=your_secure_db_password
DB_PORT=5432
# Alternatively, full URI format:
# DATABASE_URL=postgresql://user:password@host:port/dbname?sslmode=require

# ------------------------------------------------------------------------------
# 4. Third-Party Integrations
# ------------------------------------------------------------------------------
# Key for the OpenRouter AI functionality
OPENROUTER_API_KEY=your_openrouter_api_key

# ------------------------------------------------------------------------------
# 5. Transcription Service Paths
# ------------------------------------------------------------------------------
# Python service endpoint. Production typically maps to an internal domain
# e.g., http://whisper-service:5000 if using Docker, or a Render private network URL
WHISPER_SERVICE_URL=http://localhost:5000
GLADIA_TIMEOUT_MS=600000

# ------------------------------------------------------------------------------
# 6. File Handling
# ------------------------------------------------------------------------------
MAX_FILE_SIZE=50
UPLOAD_DIR=./uploads

# ------------------------------------------------------------------------------
# 7. Frontend Integration Setup
# ------------------------------------------------------------------------------
# The URL pointing to your frontend. This is required for strict CORS matching.
FRONTEND_URL=https://your-frontend-domain.vercel.app
